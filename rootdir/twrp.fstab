# mount point	fstype		device					device2

/bootloader 	vfat  		/dev/block/nanda
/env      		emmc    	/dev/block/nandb
/boot			emmc		/dev/block/nandc
/system			ext4		/dev/block/nandd
/data			ext4		/dev/block/nande
/misc			emmc		/dev/block/nandf
/recovery		emmc		/dev/block/nandg
/cache 			ext4		/dev/block/nandh
/sdcard			vfat		/dev/block/nandk
/extsd			vfat		/dev/block/mmcblk0p1	/dev/block/mmcblk0 flags=storage;removable
/usb-otg auto	/dev/block/sda1		/dev/block/sda flags=display="USB-OTG";storage;removable
